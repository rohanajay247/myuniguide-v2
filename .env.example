GOOGLE_API_KEY=...

# GA as of May 2026. gemini-3.8-flash is newer if you want to compare.
LLM_MODEL=gemini-3.5-flash

# GA as of August 2026, replaces gemini-embedding-001.
EMBEDDING_MODEL=gemini-embedding-2

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=myuniguide_v2
CORPUS_DIR=./corpus
TOP_K=5

# Read by the evaluation harness only. Never by src/.
# Point this at the folder holding benchmark_questions.yaml etc., outside this repo.
GROUND_TRUTH_DIR=../corpus-ground-truth
